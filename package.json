{
  "name": "warding-monorepo",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "tokens:build": "turbo run build sync:dart --filter=warding-design-tokens",
    "typecheck": "turbo run typecheck",
    "web:build": "turbo run build --filter=warding-web",
    "web:dev": "turbo run dev --filter=warding-web"
  },
  "devDependencies": {
    "turbo": "^2.11.11"
  }
}
