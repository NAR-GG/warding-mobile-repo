{
  "name": "warding-monorepo",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "app:local": "apps/mobile/tool/run.sh local",
    "app:prod": "apps/mobile/tool/run.sh prod",
    "build": "turbo run build",
    "lint:fsd": "turbo run lint:fsd",
    "test": "turbo run test",
    "tokens:build": "turbo run build sync:dart --filter=warding-design-tokens",
    "typecheck": "turbo run typecheck",
    "web:build": "turbo run build --filter=warding-web",
    "web:dev": "turbo run dev --filter=warding-web",
    "web:prod": "tools/web-prod.sh"
  },
  "devDependencies": {
    "turbo": "^2.11.11"
  }
}
