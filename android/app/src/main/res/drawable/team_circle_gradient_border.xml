<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFE87558"
                android:centerColor="#FFC865C9"
                android:endColor="#FF791BB8"
                android:type="sweep" />
            <size android:width="36dp" android:height="36dp" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#FF1F2024" />
        </shape>
    </item>
</layer-list>
