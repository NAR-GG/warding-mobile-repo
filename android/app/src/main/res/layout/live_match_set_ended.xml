<?xml version="1.0" encoding="utf-8"?>
<!--
  실시간 경기 알림 — 세트 종료.
    1단 30dp: Warding 로고 + "SET n 종료"
    2단 30dp: "SET n이 종료되었습니다. SET n+1 준비 중입니다."
              (다음 세트는 그라디언트 강조 — RemoteViews 라 코드에서 Spannable 로 처리)
    3단 93dp: 좌 평점 유도 / 우 양 팀 로고(하트)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ── 1단: 로고 + "SET n 종료" ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/live_header_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/live_logo"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:scaleType="fitStart"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/live_ended_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textColor="@color/live_text" />
    </LinearLayout>

    <!-- ── 2단: 다음 세트 안내 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/live_header_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/live_next_set_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="@color/live_text" />
    </LinearLayout>

    <!-- ── 3단: 평점 유도 + 팀 로고 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="93dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/live_score_row_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <!-- 좌: 리그명 / "A VS B 어떠셨나요?" / 별 + 평점 남기기 -->
        <LinearLayout
            android:id="@+id/live_rating_prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/live_league"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="@color/live_text" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/live_versus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:textColor="@color/live_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="어떠셨나요?"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:textColor="@color/live_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/live_stars"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/live_rating_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:textColor="@color/live_rating_text" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/live_chevron_right"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>

        <!-- 우: 양 팀 로고 (간격 9, 좌우 패딩 9) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="9dp"
            android:paddingEnd="9dp">

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp">

                <ImageView
                    android:id="@+id/live_team_a_logo"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/live_logo_box"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/live_team_a_heart"
                    android:layout_width="13dp"
                    android:layout_height="11dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/live_heart"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="9dp">

                <ImageView
                    android:id="@+id/live_team_b_logo"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/live_logo_box"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/live_team_b_heart"
                    android:layout_width="13dp"
                    android:layout_height="11dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/live_heart"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
