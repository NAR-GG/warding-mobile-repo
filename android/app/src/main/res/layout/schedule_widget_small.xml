<?xml version="1.0" encoding="utf-8"?>
<!-- 바깥 FrameLayout 은 "앱을 열어 주세요" 안내를 겹치기 위한 것이다
     (schedule_widget.xml 과 같은 구조). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- 날짜 헤더 -->
    <TextView
        android:id="@+id/small_date_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="07.26(일)"
        android:textColor="#FFFFFFFF"
        android:textSize="16dp"
        android:textStyle="bold"
        android:singleLine="true"
        android:paddingBottom="8dp" />

    <!-- 세로선 + 경기 리스트 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:src="@drawable/gradient_line"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/small_matches_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp" />
    </LinearLayout>

</LinearLayout>

    <include layout="@layout/widget_locked_overlay" />

</FrameLayout>
