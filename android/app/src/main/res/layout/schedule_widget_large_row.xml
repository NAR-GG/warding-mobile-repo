<?xml version="1.0" encoding="utf-8"?>
<!-- 대형 위젯 캘린더 한 주(7일) 행: 날짜 숫자 + 경기 칩(2개) + 추가 표시 + 셀 구분선 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/large_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <!-- Day 0 (월) -->
    <FrameLayout
        android:id="@+id/large_day0_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minHeight="54dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:paddingStart="1dp"
            android:paddingEnd="1dp">
            <TextView
                android:id="@+id/large_day0_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:gravity="center" />
            <TextView
                android:id="@+id/large_day0_chip"
                android:layout_width="match_parent"
                android:layout_height="13dp"
                android:textSize="8dp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:singleLine="true"
                android:background="@drawable/large_chip_bg"
                android:paddingStart="1dp"
                android:paddingEnd="1dp"
                android:layout_marginTop="1dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/large_day0_chip2"
                android:layout_width="match_parent"
                android:layout_height="13dp"
                android:textSize="8dp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:singleLine="true"
                android:background="@drawable/large_chip_bg"
                android:paddingStart="1dp"
                android:paddingEnd="1dp"
                android:layout_marginTop="1dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/large_day0_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="6dp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>
        <ImageView
            android:id="@+id/large_day0_border"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#80A6A7AB"
            android:importantForAccessibility="no" />
    </FrameLayout>

