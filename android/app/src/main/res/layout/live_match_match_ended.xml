<?xml version="1.0" encoding="utf-8"?>
<!--
  실시간 경기 알림 — 경기 종료.
    1단 30dp: Warding 로고 + "A VS B 마지막 세트가 종료됐습니다."
    2단 93dp: 팀 · 스코어 · 팀 (배경 불투명 #FFF)
    3단      : 상단 그라디언트 보더 3dp + 리그명(70%) / "SET n 평점 남기기"
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ── 1단: 로고 + 종료 문구 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/live_header_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/live_logo"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:scaleType="fitStart"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/live_ended_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="@color/live_text" />
    </LinearLayout>

    <!-- ── 2단: 팀 · 스코어 · 팀 (불투명 배경) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="93dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/live_header_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="68dp"
            android:layout_height="70dp"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom">

            <ImageView
                android:id="@+id/live_team_a_logo"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/live_logo_box"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/live_team_a_name"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textSize="13sp"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="@color/live_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="116dp"
            android:layout_height="77dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/live_score_a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="36sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/live_score_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:includeFontPadding="false"
                android:textColor="@color/live_score_text" />

            <TextView
                android:id="@+id/live_score_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="36sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/live_score_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="68dp"
            android:layout_height="70dp"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom">

            <ImageView
                android:id="@+id/live_team_b_logo"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/live_logo_box"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/live_team_b_name"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textSize="13sp"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="@color/live_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── 3단: 그라디언트 보더 + 리그명 / 평점 남기기 ── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/live_gradient_border" />

    <LinearLayout
        android:id="@+id/live_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/live_score_row_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/live_league"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:alpha="0.7"
            android:includeFontPadding="false"
            android:textColor="@color/live_text" />

        <TextView
            android:id="@+id/live_rating_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textColor="@color/live_text" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/live_chevron_right"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
