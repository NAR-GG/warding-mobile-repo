<?xml version="1.0" encoding="utf-8"?>
<!--
  실시간 경기 알림(Live Activity 대응) 색상 — 라이트 모드.
  iOS 위젯의 LiveColors 와 같은 시안 값을 쓴다.
  다크 모드 값은 values-night/live_activity_colors.xml 에 있다.
-->
<resources>
    <!-- 상단 두 줄 배경 — #FFFFFF -->
    <color name="live_header_bg">#FFFFFFFF</color>
    <!-- 스코어 줄 배경 — #FFFFFF 80% -->
    <color name="live_score_row_bg">#CCFFFFFF</color>
    <!-- 본문 텍스트 — #101113 -->
    <color name="live_text">#FF101113</color>
    <!-- 스코어 박스 배경 — #FAFAFA -->
    <color name="live_score_box_bg">#FFFAFAFA</color>
    <!-- 스코어 숫자 — #909296 -->
    <color name="live_score_text">#FF909296</color>
    <!-- 평점 유도 문구 — #25262B -->
    <color name="live_rating_text">#FF25262B</color>

    <!-- 팀 로고 박스 배경 — 라이트/다크 공통 #000000 -->
    <color name="live_logo_box">#FF000000</color>

    <!-- LIVE 배지 (라이트/다크 공통 — 시안이 동일) -->
    <color name="live_badge_bg">#FFFFF5F5</color>
    <color name="live_badge_border">#FFFFA8A8</color>
    <color name="live_badge_fg">#FFE03131</color>

    <!-- 메인 그라디언트 (앱 AppColors.narBg 와 같은 값) -->
    <color name="live_gradient_start">#FFE87558</color>
    <color name="live_gradient_center">#FFC865C9</color>
    <color name="live_gradient_end">#FF791BB8</color>
</resources>
