{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "warding-design-tokens#sync:dart"],
      "outputs": ["build/**", ".next/**", "!.next/cache/**"]
    },
    "warding-design-tokens#build": {
      "inputs": ["source/**", "build.mjs"],
      "outputs": ["build/**"]
    },
    "warding-design-tokens#sync:dart": {
      "dependsOn": ["warding-design-tokens#build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
